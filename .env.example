# ==============================================================================
# OpsSage AI - Environment Configuration Example
# Copy this file to '.env' and fill in the appropriate secrets and credentials.
# NEVER commit the real '.env' file to source control.
# ==============================================================================

# Application Settings
APP_NAME=OpsSage AI
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000

# MongoDB Atlas Connection
# Format for Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Format for Local MongoDB: mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=opssage_ai
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=0
MONGODB_TIMEOUT_MS=5000

# JWT Authentication
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Provider Configuration ("gemini" or "openai")
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Vector Search Configuration (MongoDB Atlas Search Index Name)
ATLAS_VECTOR_INDEX_NAME=vector_index_knowledge_base
