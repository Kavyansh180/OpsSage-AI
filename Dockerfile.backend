# ==============================================================================
# OpsSage AI - Backend Dockerfile
# Production-ready, multi-stage, non-root user with pre-cached embedding model
# ==============================================================================

# --- Stage 1: Builder ---
FROM python:3.10-slim AS builder

WORKDIR /build

# Install system build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install wheels
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# --- Stage 2: Production Runtime ---
FROM python:3.10-slim AS runner

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8000 \
    APP_ENV=production \
    PATH="/home/appuser/.local/bin:$PATH" \
    HF_HOME="/home/appuser/.cache/huggingface"

# Install curl for container health checks and clean apt cache
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root system user and cache directories
RUN groupadd --gid 10001 appgroup && \
    useradd --uid 10001 --gid appgroup --shell /bin/bash --create-home appuser && \
    mkdir -p /home/appuser/.cache/huggingface && \
    mkdir -p /app && \
    chown -R appuser:appgroup /home/appuser /app

# Switch to non-root user
USER appuser
WORKDIR /app

# Copy installed Python packages from builder
COPY --from=builder --chown=appuser:appgroup /root/.local /home/appuser/.local

# Pre-download Sentence Transformer model to avoid cold-start latency and network dependency in production
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')"

# Copy application code
COPY --chown=appuser:appgroup backend /app/backend
COPY --chown=appuser:appgroup scripts /app/scripts
COPY --chown=appuser:appgroup requirements.txt /app/requirements.txt

# Expose backend API port
EXPOSE 8000

# Healthcheck targeting the application readiness/health endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

# Launch ASGI application
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
